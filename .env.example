# ============================================================
# mirofish configuration template
# ============================================================
# 1. copy this file to .env.
# 2. fill real values before running the enhanced project.
# 3. do not commit a real .env file to github.
# ============================================================


# ============================================================
# 1. flask backend
# ============================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=true
SECRET_KEY=change_me_to_a_long_random_secret


# ============================================================
# 2. openai-compatible llm
# ============================================================
# required. examples:
# - https://dashscope.aliyuncs.com/compatible-mode/v1
# - https://api.openai.com/v1
# - https://openrouter.ai/api/v1
LLM_API_KEY=your_chat_model_key_here
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL_NAME=your_chat_model_name

OPENAI_API_KEY=your_chat_model_key_here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=your_chat_model_name

# required for semantic recall.
EMBEDDING_MODEL=your_embedding_model_name
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
ONTOLOGY_LLM_TIMEOUT_SECONDS=20
ONTOLOGY_LLM_MAX_TOKENS=1600
ONTOLOGY_USE_FAST_PROMPT=true
ONTOLOGY_ENABLE_RULE_FALLBACK=true
ONTOLOGY_MAX_INPUT_CHARS=6000

LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=


# ============================================================
# 3. zep graphrag
# ============================================================
ZEP_API_KEY=your_zep_api_key_here
ZEP_API_URL=
ZEP_ENHANCED_GRAPH_ID=mirofish_enhanced_memory


# ============================================================
# 4. mysql
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mirofish
MYSQL_PASSWORD=mirofish_password
MYSQL_DATABASE=mirofish
MYSQL_ROOT_PASSWORD=mirofish_root_password
MYSQL_CONNECT_TIMEOUT=3
MYSQL_AUTO_CREATE_TABLES=true

# MYSQL_URL=mysql+pymysql://mirofish:mirofish_password@localhost:3306/mirofish
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://mirofish:mirofish_password@localhost:3306/mirofish


# ============================================================
# 5. rabbitmq and celery
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=mirofish
RABBITMQ_PASSWORD=mirofish_password
RABBITMQ_VHOST=/

CELERY_BROKER_URL=amqp://mirofish:mirofish_password@localhost:5672//
CELERY_RESULT_BACKEND=disabled://
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=600
CELERY_BROKER_CONNECTION_TIMEOUT=3


# ============================================================
# 6. chroma
# ============================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_HTTP_URL=http://localhost:8000
CHROMA_USE_HTTP=false
CHROMA_PERSIST_DIR=./backend/uploads/chroma
CHROMA_COLLECTION_NAME=mirofish_memory

MEMORY_RECALL_SEMANTIC_WEIGHT=0.5
MEMORY_RECALL_IMPORTANCE_WEIGHT=0.3
MEMORY_RECALL_TIME_DECAY_WEIGHT=0.2
MEMORY_RECALL_CANDIDATES=20
MEMORY_TIME_DECAY_HALF_LIFE_DAYS=30


# ============================================================
# 7. active ingestion
# ============================================================
# rss is a real keyless provider. replace ACTIVE_SEARCH_RSS_URLS with your own
# rss/search endpoint template if google news rss is unavailable in your network.
ACTIVE_SEARCH_PROVIDER=rss
ACTIVE_SEARCH_RSS_URLS=https://news.google.com/rss/search?q={query}&hl=zh-CN&gl=CN&ceid=CN:zh-Hans
ACTIVE_SEARCH_MAX_RESULTS=5
ACTIVE_SEARCH_TIMEOUT_SECONDS=20
ACTIVE_SEARCH_USER_AGENT=MiroFish-Pro/1.0
INGESTION_KEYWORDS=方案 X,能源市场
INGESTION_INTERVAL_SECONDS=3600
INGESTION_CONTENT_MIN_LENGTH=20
INGESTION_DEDUP_SIMILARITY_THRESHOLD=0.88

SUMMARY_MAX_INPUT_CHARS=4000


# ============================================================
# 8. multi-agent review
# ============================================================
REVIEW_CLAIM_MIN_LENGTH=12
REVIEW_MAX_CLAIMS=20
REVIEW_EVIDENCE_TOP_K=5
REVIEW_USE_ACTIVE_SEARCH=false


# ============================================================
# 9. traceable report agent
# ============================================================
TRACEABLE_REPORT_MEMORY_TOP_K=5
TRACEABLE_REPORT_GRAPH_LIMIT=5
TRACEABLE_REPORT_MAX_SEARCH_RESULTS=5
TRACEABLE_REPORT_MAX_INTERVIEWS=5
TRACEABLE_REPORT_INTERVIEW_TIMEOUT_SECONDS=15
TRACEABLE_REPORT_REVIEW_MAX_CLAIMS=2
TRACEABLE_REPORT_FAST_REVIEW=true
TRACEABLE_REPORT_MAX_TOKENS=1200
TRACEABLE_REPORT_REVISE_WITH_LLM=false
TRACEABLE_REPORT_DRAFT_TIMEOUT_SECONDS=30


# ============================================================
# 10. original upload and simulation defaults
# ============================================================
MAX_CONTENT_LENGTH=52428800
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
